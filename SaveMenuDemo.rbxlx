      <Item class="Script" referent="RBX25">
        <Properties>
          <string name="Name">RemoteBridge</string>
          <ProtectedString name="Source">-- Remote API: clients cannot set checkpoint, coins, playtime, datastore key or session token.
-- CC0-1.0 | timura032
local Players = game:GetService("Players")
local shared = game:GetService("ReplicatedStorage"):WaitForChild("SaveMenuPack")
local Config = require(shared.Config)
local Service = require(script.Parent.ProfileService)
assert(not shared:FindFirstChild("Request"), "Install only one RemoteBridge")
local request = Instance.new("RemoteFunction")
request.Name = "Request"; request.Parent = shared
local gates = {}
request.OnServerInvoke = function(player, action, name, value)
    local gate = gates[player]
    if not gate then gate = {nextRequest = 0, nextSave = 0, nextLoad = 0}; gates[player] = gate end
    local now = os.clock()
    if type(action) ~= "string" or #action &gt; 20 or now &lt; gate.nextRequest then
        local result = Service.Snapshot(player); result.Message = "RATE_LIMIT"; return result
    end
    gate.nextRequest = now + 0.2
    if action == "Status" then return Service.Snapshot(player) end
    if gate.busy then local result = Service.Snapshot(player); result.Message = "BUSY"; return result end
    gate.busy = true
    local message
    local ok = pcall(function()
        if action == "Play" then
            if not Service.Start(player) then message = "NOT_READY" end
        elseif action == "RetryLoad" then
            if now &lt; gate.nextLoad then message = "RATE_LIMIT"; return end
            gate.nextLoad = now + 8
            Service.Load(player)
        elseif action == "Save" then
            if now &lt; gate.nextSave then message = "SAVE_COOLDOWN"; return end
            gate.nextSave = now + Config.MANUAL_SAVE_COOLDOWN
            if not Service.Save(player, false, os.clock() + 15) then message = "SAVE_FAILED" end
        elseif action == "Setting" then
            if type(name) ~= "string" or #name &gt; 30 or not Service.SetSetting(player, name, value) then message = "INVALID_SETTING" end
        else message = "UNKNOWN_ACTION" end
    end)
    gate.busy = false
    if not ok then message = "SERVER_ERROR"; warn("SaveMenuPack request failed") end
    local result = Service.Snapshot(player)
    result.Message = message
    return result
end
Players.PlayerRemoving:Connect(function(player) gates[player] = nil end)
</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX26">
        <Properties>
          <string name="Name">SaveRepository</string>
          <ProtectedString name="Source">-- Server ModuleScript. Atomic lease + idempotent saves. CC0-1.0 | timura032
local Schema = require(script.Parent.Schema)
local Repository = {}
Repository.__index = Repository
-- Dependencies are injected so the same logic can be tested without real DataStores.
function Repository.new(store, config, clock, pause, guid)
    return setmetatable({store = store, config = config, clock = clock, pause = pause, guid = guid}, Repository)
end
function Repository:update(key, transform, deadline)
    for attempt = 1, self.config.RETRY_COUNT do
        if deadline and os.clock() &gt;= deadline then return nil, "DEADLINE" end
        local reason
        local ok, record = pcall(function()
            return self.store:UpdateAsync(key, function(current)
                -- Roblox may invoke this callback multiple times. No yields or side effects here.
                local nextRecord, rejected = transform(current)
                reason = rejected
                return nextRecord
            end)
        end)
        if ok then
            if record == nil then return nil, reason or "CANCELLED" end
            return record
        end
        if attempt &lt; self.config.RETRY_COUNT then
            local delay = math.min(2 ^ (attempt - 1), 4)
            if deadline and os.clock() + delay &gt;= deadline then return nil, "DEADLINE" end
            self.pause(delay)
        end
    end
    return nil, "DATASTORE_UNAVAILABLE"
end
function Repository:acquire(key, token, deadline)
    return self:update(key, function(current)
        local data, invalid = Schema.decode(current)
        if not data then return nil, invalid end
        local now = self.clock()
        local lock = current and current.Session
        if lock and lock.Id ~= token and lock.Expires &gt; now then return nil, "SESSION_LOCKED" end
        return {
            SchemaVersion = Schema.VERSION,
            Revision = current and current.Revision or 0,
            Data = data,
            Session = {Id = token, Expires = now + self.config.LEASE_SECONDS},
            WriteId = current and current.WriteId or nil,
        }
    end, deadline)
end
function Repository:save(key, token, data, release, deadline)
    local operation = self.guid() -- One ID across all retries of this logical write.
    local frozen = Schema.copy(data)
    return self:update(key, function(current)
        local decoded, invalid = Schema.decode(current)
        if not decoded or current == nil then return nil, invalid or "SESSION_LOST" end
        -- A write may have committed even if its network response failed.
        if current.WriteId == operation then return current end
        if not current.Session or current.Session.Id ~= token then return nil, "SESSION_LOST" end
        return {
            SchemaVersion = Schema.VERSION,
            Revision = (current.Revision or 0) + 1,
            Data = frozen,
            Session = not release and {Id = token, Expires = self.clock() + self.config.LEASE_SECONDS} or nil,
            WriteId = operation,
        }
    end, deadline)
end
return Repository
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX27">
        <Properties>
          <string name="Name">Schema</string>
          <ProtectedString name="Source">-- Server ModuleScript. CC0-1.0 | timura032
local Schema = {}
Schema.VERSION = 1
local function finite(value)
    return type(value) == "number" and value == value and value &gt; -math.huge and value &lt; math.huge
end
local function integer(value, default, maximum)
    if not finite(value) then return default end
    return math.max(0, math.min(maximum, math.floor(value)))
end
function Schema.defaults()
    return {Checkpoint = 0, Coins = 0, PlaySeconds = 0, Settings = {MusicVolume = 0.5, ReducedMotion = false}}
end
function Schema.copy(data)
    local settings = type(data.Settings) == "table" and data.Settings or {}
    return {
        Checkpoint = integer(data.Checkpoint, 0, 100000),
        Coins = integer(data.Coins, 0, 1000000000),
        PlaySeconds = integer(data.PlaySeconds, 0, 10000000000),
        Settings = {
            MusicVolume = finite(settings.MusicVolume) and math.max(0, math.min(1, settings.MusicVolume)) or 0.5,
            ReducedMotion = settings.ReducedMotion == true,
        },
    }
end
function Schema.decode(record)
    if record == nil then return Schema.defaults() end
    if type(record) ~= "table" or record.SchemaVersion ~= Schema.VERSION or type(record.Data) ~= "table" then
        return nil, "UNSUPPORTED_DATA" -- Never replace unreadable/newer records with defaults.
    end
    if record.Session ~= nil then
        if type(record.Session) ~= "table" or type(record.Session.Id) ~= "string" or not finite(record.Session.Expires) then
            return nil, "INVALID_SESSION"
        end
    end
    if record.Revision ~= nil and (not finite(record.Revision) or record.Revision &lt; 0) then return nil, "INVALID_REVISION" end
    return Schema.copy(record.Data)
end
return Schema
</ProtectedString>
        </Properties>
      </Item>
