      <Item class="LocalScript" referent="RBX32">
        <Properties>
          <string name="Name">MenuCamera</string>
          <ProtectedString name="Source">-- Optional menu camera; delete this LocalScript if you use another camera controller.
-- CC0-1.0 | timura032
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer
local demo = workspace:WaitForChild("SaveMenuDemo", 15)
local point = demo and demo:WaitForChild("MenuCamera", 15)
if not point or not point:IsA("BasePart") then return end
local saved, elapsed
local function restore()
    if not saved then return end
    local camera = saved.camera
    camera.CameraType = saved.kind
    camera.CameraSubject = player.Character and player.Character:FindFirstChildOfClass("Humanoid") or saved.subject
    camera.CFrame = saved.frame
    saved = nil
end
local connection = RunService.RenderStepped:Connect(function(dt)
    local camera = workspace.CurrentCamera
    if not player:GetAttribute("SaveMenuOpen") or not point.Parent or not camera then restore(); return end
    if saved and saved.camera ~= camera then restore() end
    if not saved then
        saved = {camera = camera, kind = camera.CameraType, subject = camera.CameraSubject, frame = camera.CFrame}
        elapsed = 0; camera.CameraType = Enum.CameraType.Scriptable
    end
    elapsed = elapsed + dt
    local offset = player:GetAttribute("SaveMenuReducedMotion") and Vector3.zero or Vector3.new(math.sin(elapsed * 0.2) * 0.4, 0, 0)
    camera.CFrame = point.CFrame + offset
end)
script.Destroying:Connect(function() connection:Disconnect(); restore() end)
</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="RBX33">
        <Properties>
          <string name="Name">ProgressHUD</string>
          <ProtectedString name="Source">-- LocalScript. Mobile-friendly menu button and live checkpoint/coin counters. CC0-1.0
local player = game:GetService("Players").LocalPlayer
local pg = player:WaitForChild("PlayerGui")
local shared = game:GetService("ReplicatedStorage"):WaitForChild("SaveMenuPack")
local UI = require(shared:WaitForChild("UIFactory"))
local old = pg:FindFirstChild("SaveMenuHUD"); if old then old:Destroy() end
local gui = UI.new("ScreenGui", pg, {Name = "SaveMenuHUD", ResetOnSpawn = false, DisplayOrder = 20})
local bar = UI.new("Frame", gui, {Position = UDim2.new(0, 12, 0, 12), Size = UDim2.new(1, -24, 0, 48), BackgroundColor3 = Color3.fromRGB(22, 25, 33)})
UI.round(bar); UI.new("UISizeConstraint", bar, {MaxSize = Vector2.new(480, 48)})
local button = UI.button(bar, UI.text(UI.language(player), "Меню", "Menu"), function()
    local open = pg:FindFirstChild("SaveMenuOpen")
    if open then open:Fire() end
end)
button.Size = UDim2.fromOffset(92, 48)
local label = UI.label(bar, "", 48); label.Position = UDim2.fromOffset(104, 0); label.Size = UDim2.new(1, -110, 1, 0); label.TextSize = 14
local function update()
    local playing = player:GetAttribute("SaveMenuStarted") == true
    gui.Enabled = playing
    local stage, coins = player:GetAttribute("SaveMenuCheckpoint") or 0, player:GetAttribute("SaveMenuCoins") or 0
    label.Text = string.format(UI.text(UI.language(player), "Этап %d · Монеты %d", "Stage %d · Coins %d"), stage, coins)
end
